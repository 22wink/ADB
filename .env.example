# 仅允许本机访问（生产/默认）
HOST=127.0.0.1
PORT=3789

# 开发 Mock：1=模拟设备/数据，0=真实 ADB（仅开发有效；pnpm start / release 忽略）
# 也可用 pnpm dev:server:real / server 的 pnpm dev:real 强制关 Mock
ADB_MOCK=1

# ADB 可执行文件（可省略，会自动按系统选 platform-tools/{windows|darwin}/）
# Windows: ./platform-tools/windows/adb.exe
# macOS:   ./platform-tools/darwin/adb
ADB_PATH=./platform-tools/windows/adb.exe

# 单 IP 每分钟最大请求数
RATE_LIMIT_PER_MIN=120
