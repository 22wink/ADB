{
  "name": "adb-studio",
  "private": true,
  "version": "1.0.0",
  "description": "ADB 可视化操作工具（本机安全代理）",
  "scripts": {
    "dev": "pnpm --parallel --filter @adb-studio/server --filter @adb-studio/web dev",
    "dev:server": "pnpm --filter @adb-studio/server dev",
    "dev:server:real": "pnpm --filter @adb-studio/server dev:real",
    "dev:web": "pnpm --filter @adb-studio/web dev",
    "build": "node scripts/build.mjs",
    "fetch:adb": "node scripts/fetch-platform-tools.mjs",
    "fetch:adb:all": "node scripts/fetch-platform-tools.mjs all",
    "fetch:adb:mac": "node scripts/fetch-platform-tools.mjs darwin",
    "fetch:adb:win": "node scripts/fetch-platform-tools.mjs windows",
    "release": "node scripts/pack.mjs",
    "release:mac": "node scripts/pack-mac.mjs",
    "release:mac:arm64": "node scripts/pack-mac.mjs arm64",
    "release:mac:x64": "node scripts/pack-mac.mjs x64",
    "start": "node apps/server/dist/index.js",
    "start:release": "node release/ADB-Studio/server.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.12"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.24.0"
}